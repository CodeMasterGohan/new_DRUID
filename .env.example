# ── new_DRUID environment template ──────────────────────────────────────
# Copy to .env and fill in. Never commit a filled .env.

# ── PostgreSQL (catalog) ──
POSTGRES_USER=druid
POSTGRES_PASSWORD=change-me
POSTGRES_DB=druid_catalog
DATABASE_URL=postgresql+psycopg://druid:change-me@postgres:5432/druid_catalog

# ── Redis (queue broker + cache) ──
REDIS_URL=redis://redis:6379/0

# ── RustFS (tenant-scoped object storage) ──
RUSTFS_ACCESS_KEY=druid
RUSTFS_SECRET_KEY=change-me-min-8-chars
RUSTFS_ENDPOINT=rustfs:9000
RUSTFS_BUCKET=druid-artifacts

# ── Milvus ──
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=project_knowledge_base_v1
MILVUS_ALIAS=project_knowledge_base

# ── Keycloak OIDC (browser + Bearer API authentication) ──
# OIDC login is mandatory. DRUID PostgreSQL owns all user/group permissions.
DRUID_AUTH_MODE=keycloak
JWT_ALGORITHMS=RS256
# Keycloak must add druid-api to the access token AUD claim.
# Replace the realm/hostname values below with your actual Keycloak settings.
OIDC_ISSUER=https://auth.internal.example/realms/druid
OIDC_CLIENT_ID=druid-web
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://druid.example.invalid/auth/oidc/callback
# Generate with: openssl rand -hex 32 (never commit a filled value).
OIDC_SESSION_SECRET=
# First login bootstrap: exact Keycloak sub UUID of initial admin.
# Remove this setting after the first admin is provisioned.
DRUID_BOOTSTRAP_ADMIN_SUB=
API_BIND_IP=127.0.0.1
API_PORT=8000

# ── Auth (gateway) ──
JWT_ISSUER=https://auth.internal.example/realms/druid
JWT_AUDIENCE=druid-api
# JWKS_URL or inline public key for token verification:
JWKS_URL=https://auth.internal.example/realms/druid/protocol/openid-connect/certs

# ── Quotas (§4) ──
QUOTA_INGEST_PAGES_PER_DAY=1000
QUOTA_QUERY_QPS=10
MAX_UPLOAD_MB=200
MAX_PAGES_PER_DOCUMENT=2000

# ── Model artifacts (mounted read-only from host registry) ──
MODEL_DIR=/DATA/docker/mounts/models
# gpu: native parsing + visual OCR; cpu: native parsing, OCR pages go to review.
# Embeddings/reranking use CPU in both modes. Restart ingestion after changing.
DRUID_PROCESSING_MODE=gpu
OLMOCR_MODEL_DIR=/DATA/docker/mounts/models/allenai/olmOCR-2-7B-1025-FP8
EMBEDDING_MODEL_DIR=/DATA/docker/mounts/models/google/embeddinggemma-2
# EMBEDDING_MODEL_PATH is the primary name the embedding service reads;
# EMBEDDING_MODEL_DIR is accepted as a fallback alias.
EMBEDDING_MODEL_PATH=/DATA/docker/mounts/models/google/embeddinggemma-2
EMBEDDING_MODALITY_CONFIG=text+image
EMBEDDING_DIMENSION=768
EMBEDDING_BACKEND=st
RERANKER_MODEL_DIR=/DATA/docker/mounts/models/cross-encoder/ms-marco-MiniLM-L6-v2
# Tokenizer path the ingestion chunker enforces its token budget with
# (services/ingestion/chunker.py::_default_token_len, fail-closed). Points
# at the same pre-staged MiniLM artifact; kept as a separate var because the
# chunker only needs the tokenizer, not the cross-encoder weights.
MINILM_TOKENIZER_PATH=/DATA/docker/mounts/models/cross-encoder/ms-marco-MiniLM-L6-v2
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ── vLLM / olmOCR (§2 GPU arbitration: vLLM is the ONLY GPU consumer) ──
# Base URL of the vLLM OpenAI-compatible endpoint (read by the ingestion
# workers). The hostname is the gpu compose service name; it resolves
# because both compose projects attach to the shared external `druid-net`
# network (see deploy/*.yml + runbook step 0).
OLMOCR_VLLM_URL=http://vllm-olmocr:8000
VLLM_GPU_MEMORY_UTILIZATION=0.7
VLLM_MAX_MODEL_LEN=8192

# ── Service ports ──
# run on the same H200 host. The gateway container still listens on 8000
# internally; only the host-side mapping moves.
WEB_UI_PORT=8005
# MCP is internal-only; external clients use /mcp on the HTTPS API gateway.
# Use an HTTPS reverse proxy to expose the UI publicly; never publish
# the unauthenticated transport or browser session cookies on cleartext.
WEB_UI_BIND_IP=127.0.0.1
MCP_PORT=8002
# Operator-only diagnostics; requires both flag and authenticated admin role.
DRUID_RETRIEVAL_DIAGNOSTICS=0

# ── Service URLs (compose DNS: service names use underscores) ──
DOCUMENT_API_URL=http://document_api:8001
MCP_SERVER_URL=http://mcp_server:8002
GATEWAY_URL=http://gateway:8000
RETRIEVAL_URL=http://retrieval:8004

# ── Internal identity propagation (gateway → backend services) ──
# HMAC secret the gateway uses to sign X-Druid-* identity headers.
# Backend services verify the signature before trusting the context.
# Never commit a filled value.
# The MCP server also needs it: it signs the same headers when calling
# the retrieval and document_api services downstream.
INTERNAL_SECRET=<redacted>

# ── MCP server (Streamable HTTP, authenticated) ──
# One of JWT_SECRET (HS256 shared secret) or JWT_PUBLIC_KEY_PEM (RS256) is
# required for bearer-token verification. Never commit a filled value.
JWT_SECRET=change-me
# JWT_PUBLIC_KEY_PEM=
# Comma-separated origins allowed to present an Origin header (DNS-rebinding
# protection for browser-based MCP clients). Requests without an Origin
# header (native clients) are allowed; requests WITH a non-allowlisted
# Origin are rejected with 403.
MCP_ALLOWED_ORIGINS=
# Timeout (seconds) for the MCP server's downstream HTTP calls to the
# retrieval and document_api services. Real HTTP clients are the default;
# DRUID_MCP_DEV_FAKE_CLIENTS=1 selects the in-memory fakes (tests/dev only).
MCP_DOWNSTREAM_TIMEOUT_SECONDS=30
# DRUID_MCP_DEV_FAKE_CLIENTS=1
