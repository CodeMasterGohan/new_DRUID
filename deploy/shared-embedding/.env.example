# Staged full google/embeddinggemma-2 snapshot, including tokenizer/processor files.
EMBEDDING_MODEL_DIR=/DATA/docker/mounts/models/google/embeddinggemma-2
# Generate once; put the same secret into both applications' env files.
EMBEDDING_VLLM_API_KEY=
EMBEDDING_VLLM_IMAGE=vllm/vllm-openai:v0.32.0
EMBEDDING_VLLM_GPU_MEMORY_UTILIZATION=0.10
EMBEDDING_VLLM_MAX_NUM_SEQS=64
EMBEDDING_VLLM_MAX_BATCHED_TOKENS=32768
